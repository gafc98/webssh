# Required: generate with  python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
WEBSSH_SESSION_SECRET=replace-with-a-random-secret

# Emailed sign-in codes (second factor). Set all three to enable; PASSWORD is a Gmail app password.
#SENDER_EMAIL=you@gmail.com
#PASSWORD=abcdefghijklmnop
#RECEIVER_EMAIL=trusted@example.com
#WEBSSH_OTP_TTL_MINUTES=5
#WEBSSH_SMTP_HOST=smtp.gmail.com
#WEBSSH_SMTP_PORT=587

# Set to false only for plain-HTTP testing on the device itself.
WEBSSH_COOKIE_SECURE=true

# Bind address used by start_services.sh.
#WEBSSH_HOST=127.0.0.1
#WEBSSH_PORT=8000

#LOG_LEVEL=INFO
#WEBSSH_AUDIT_LOG=audit.log

#WEBSSH_SESSION_IDLE_MINUTES=30
#WEBSSH_TERMINAL_GRACE_SECONDS=300
#WEBSSH_MAX_TERMINALS=8
#WEBSSH_MAX_UPLOAD_MB=100

# Failed sign-ins allowed per IP before an exponential lockout starts.
#WEBSSH_LOGIN_FREE_ATTEMPTS=3
#WEBSSH_LOGIN_MAX_LOCKOUT_SECONDS=900

# Enables the in-app "Update available" button (git pull + restart).
#WEBSSH_ALLOW_UPDATE=true
